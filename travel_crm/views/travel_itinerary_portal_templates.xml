<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_itinerary_template" name="Travel Itinerary Portal">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty pb-5" style="background-color: #f1f5f9; min-height: 90vh;">
                <style>
                    :root {
                        --primary-travel: #0080ff;
                        --dark-travel: #0f172a;
                    }
                    .hero-banner-travel {
                        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f2744 100%);
                        color: #ffffff;
                        padding: 45px 0 55px;
                        border-radius: 0 0 24px 24px;
                        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
                    }
                    .hero-badge-travel {
                        background: rgba(255, 255, 255, 0.15);
                        backdrop-filter: blur(8px);
                        border: 1px solid rgba(255, 255, 255, 0.2);
                        color: #e2e8f0;
                        padding: 6px 14px;
                        border-radius: 20px;
                        font-size: 13px;
                        font-weight: 600;
                        display: inline-flex;
                        align-items: center;
                        gap: 6px;
                    }
                    .card-custom-travel {
                        background: #ffffff;
                        border: 1px solid #e2e8f0;
                        border-radius: 16px;
                        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
                        margin-bottom: 24px;
                        overflow: hidden;
                    }
                    .day-number-badge-travel {
                        min-width: 75px;
                        padding: 10px 14px;
                        background: linear-gradient(135deg, #0080ff 0%, #0059b3 100%);
                        color: #ffffff;
                        border-radius: 14px;
                        text-align: center;
                        box-shadow: 0 4px 10px rgba(0, 128, 255, 0.25);
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                    }
                    .day-number-badge-travel .day-label-txt {
                        font-size: 11px;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        opacity: 0.9;
                        font-weight: 700;
                        line-height: 1;
                    }
                    .day-number-badge-travel .day-num-txt {
                        font-size: 22px;
                        font-weight: 900;
                        line-height: 1.1;
                        margin-top: 2px;
                    }
                    .meal-badge-travel {
                        background: #fef3c7;
                        color: #b45309;
                        border-radius: 6px;
                        padding: 4px 10px;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    .activity-tag-travel {
                        background: #e0f2fe;
                        color: #0369a1;
                        border-radius: 6px;
                        padding: 4px 10px;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    .style-description-travel {
                        color: #334155 !important;
                        font-size: 14px;
                        line-height: 1.6;
                    }
                    .sticky-action-bar-travel {
                        position: sticky;
                        bottom: 20px;
                        z-index: 1000;
                        background: rgba(255, 255, 255, 0.95);
                        backdrop-filter: blur(12px);
                        border: 1px solid rgba(226, 232, 240, 0.8);
                        border-radius: 16px;
                        padding: 16px 24px;
                        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
                    }
                </style>

                <!-- Hero Banner -->
                <div class="hero-banner-travel mb-4">
                    <div class="container">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                            <div>
                                <span class="hero-badge-travel"><i class="fa fa-plane"></i> Personalized Travel Itinerary</span>
                            </div>
                            <div>
                                <span t-if="lead.itinerary_status == 'accepted'" class="badge bg-success fs-6"><i class="fa fa-check-circle"></i> Approved &amp; Confirmed</span>
                                <span t-elif="lead.itinerary_status == 'change_requested'" class="badge bg-warning text-dark fs-6"><i class="fa fa-exclamation-triangle"></i> Change Requested</span>
                                <span t-else="" class="badge bg-info fs-6"><i class="fa fa-paper-plane"></i> Shared Proposal</span>
                            </div>
                        </div>
                        
                        <h1 class="display-6 fw-bold mb-2 text-white">
                            <t t-out="lead.destination_id.name or lead.name"/>
                        </h1>
                        <p class="text-light opacity-75 mb-3 fs-5">
                            Prepared exclusively for <strong><t t-out="lead.contact_name or lead.partner_name or 'Valued Traveler'"/></strong>
                        </p>

                        <div class="d-flex flex-wrap gap-4 pt-2 text-light opacity-90">
                            <div><i class="fa fa-users text-info me-1"></i> <strong>Pax:</strong> <t t-out="lead.total_pax or 2"/> Persons</div>
                            <div t-if="lead.travel_date_from"><i class="fa fa-calendar-alt text-info me-1"></i> <strong>Dates:</strong> <t t-out="lead.travel_date_from"/> to <t t-out="lead.travel_date_to or 'TBD'"/></div>
                            <div t-if="lead.expected_revenue"><i class="fa fa-tag text-info me-1"></i> <strong>Package Value:</strong> <t t-out="lead.company_currency.symbol"/><t t-out="round(lead.expected_revenue, 2)"/></div>
                        </div>
                    </div>
                </div>

                <div class="container">

                    <!-- Alert Message -->
                    <div t-if="status_msg == 'accepted'" class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <i class="fa fa-check-circle me-2 fs-5"></i> <strong>Thank you!</strong> You have successfully approved this itinerary. Our travel team will process your booking details shortly.
                    </div>
                    <div t-if="status_msg == 'change_requested'" class="alert alert-warning alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <i class="fa fa-exclamation-triangle me-2 fs-5"></i> <strong>Change Request Received!</strong> Your feedback has been sent to your dedicated travel advisor. We will update your itinerary shortly.
                    </div>

                    <div class="row">
                        <!-- Day-Wise Itinerary Timeline -->
                        <div class="col-lg-8">
                            <h4 class="fw-bold mb-3 text-dark"><i class="fa fa-route text-primary me-2"></i> Day-by-Day Travel Schedule</h4>

                            <div t-if="not lead.itinerary_line_ids" class="card-custom-travel p-4 text-center text-muted">
                                <i class="fa fa-info-circle fs-3 mb-2"></i>
                                <p class="mb-0">Your itinerary schedule is currently being finalized by your travel planner.</p>
                            </div>

                            <t t-foreach="lead.itinerary_line_ids" t-as="line">
                                <div class="card-custom-travel p-4">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="day-number-badge-travel flex-shrink-0">
                                            <span class="day-label-txt">DAY</span>
                                            <span class="day-num-txt"><t t-out="line.day_number"/></span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                                <h5 class="fw-bold mb-0 text-dark"><t t-out="line.title"/></h5>
                                                <div class="d-flex gap-2">
                                                    <span t-if="line.activity_type" class="activity-tag-travel">
                                                        <t t-out="dict(line._fields['activity_type'].selection).get(line.activity_type)"/>
                                                    </span>
                                                    <span t-if="line.meals_included" class="meal-badge-travel">
                                                        <i class="fa fa-utensils me-1"></i> <t t-out="line.meals_included"/>
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="style-description-travel mb-0" style="white-space: pre-line;">
                                                <t t-out="line.description"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Sidebar: Inclusions & Exclusions -->
                        <div class="col-lg-4">
                            <!-- Inclusions Card -->
                            <div class="card-custom-travel p-4">
                                <h5 class="fw-bold text-success mb-3"><i class="fa fa-check-circle me-2"></i> Included in Package</h5>
                                <p class="text-secondary small mb-0" style="white-space: pre-line;">
                                    <t t-out="lead.itinerary_inclusions or 'Standard Deluxe Hotel Accommodation, Breakfast, Transfers, Sightseeing Guide.'"/>
                                </p>
                            </div>

                            <!-- Exclusions Card -->
                            <div class="card-custom-travel p-4">
                                <h5 class="fw-bold text-danger mb-3"><i class="fa fa-times-circle me-2"></i> Not Included</h5>
                                <p class="text-secondary small mb-0" style="white-space: pre-line;">
                                    <t t-out="lead.itinerary_exclusions or 'Personal expenses, Flight tickets (unless specified), Tips, Visa fees.'"/>
                                </p>
                            </div>

                            <!-- Travel Advisor Info -->
                            <div class="card-custom-travel p-4">
                                <h5 class="fw-bold text-dark mb-2"><i class="fa fa-user-shield text-primary me-2"></i> Dedicated Travel Advisor</h5>
                                <p class="mb-1 text-dark fw-semibold"><t t-out="lead.user_id.name or 'Travel Desk Expert'"/></p>
                                <p class="text-muted small mb-0"><i class="fa fa-envelope me-1"></i> <t t-out="lead.user_id.email or 'travel@company.com'"/></p>
                            </div>
                        </div>
                    </div>

                    <!-- Sticky Bottom Action Bar -->
                    <div class="sticky-action-bar-travel d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4">
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Ready to confirm your trip?</h6>
                            <small class="text-muted">Review details and approve or request changes below.</small>
                        </div>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-outline-warning fw-bold px-4" data-bs-toggle="modal" data-bs-target="#changeModal">
                                <i class="fa fa-pen me-1"></i> Request Changes
                            </button>

                            <form t-attf-action="/travel/itinerary/#{lead.portal_access_token}/accept" method="POST">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-success fw-bold px-4 shadow-sm">
                                    <i class="fa fa-check-circle me-1"></i> Approve &amp; Confirm Itinerary
                                </button>
                            </form>
                        </div>
                    </div>

                </div>

                <!-- Request Change Modal -->
                <div class="modal fade" id="changeModal" tabindex="-1" aria-labelledby="changeModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content rounded-4 border-0">
                            <form t-attf-action="/travel/itinerary/#{lead.portal_access_token}/request_change" method="POST">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold text-dark" id="changeModalLabel"><i class="fa fa-edit text-warning me-2"></i> Request Itinerary Modifications</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body py-3">
                                    <p class="text-muted small">Let us know what dates, hotels, or activities you'd like us to customize for you:</p>
                                    <textarea name="customer_feedback" class="form-control rounded-3" rows="4" placeholder="e.g. Please add 1 extra day in Ubud, and change Day 3 hotel to 5-Star Resort..." required="required"></textarea>
                                </div>
                                <div class="modal-footer border-0 pt-0">
                                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-warning rounded-3 px-4 fw-bold">Submit Change Request</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </t>
    </template>
</odoo>
