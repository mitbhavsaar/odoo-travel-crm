<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_travel_lead_invoice_wizard_form" model="ir.ui.view">
        <field name="name">travel.lead.invoice.wizard.form</field>
        <field name="model">travel.lead.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create invoice(s)">
                <sheet>
                    <group>
                        <field name="lead_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="advance_payment_method" widget="radio"/>
                        <field name="amount_percentage" invisible="advance_payment_method != 'percentage'" required="advance_payment_method == 'percentage'"/>
                        <field name="amount" widget="monetary" invisible="advance_payment_method != 'fixed'" required="advance_payment_method == 'fixed'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_invoices" string="Create Draft" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
