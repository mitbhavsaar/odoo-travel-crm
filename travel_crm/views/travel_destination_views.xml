<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_travel_destination_list" model="ir.ui.view">
        <field name="name">travel.destination.list</field>
        <field name="model">travel.destination</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="country_id"/>
                <field name="state_id" domain="[('country_id', '=', country_id)]" options="{'no_quick_create': True}"/>
                <field name="is_domestic"/>
            </list>
        </field>
    </record>

    <record id="view_travel_destination_form" model="ir.ui.view">
        <field name="name">travel.destination.form</field>
        <field name="model">travel.destination</field>
        <field name="arch" type="xml">
            <form string="Travel Destination">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="country_id"/>
                            <field name="state_id" domain="[('country_id', '=', country_id)]" options="{'no_quick_create': True}"/>
                            <field name="is_domestic"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_travel_destination" model="ir.actions.act_window">
        <field name="name">Destinations</field>
        <field name="res_model">travel.destination</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
