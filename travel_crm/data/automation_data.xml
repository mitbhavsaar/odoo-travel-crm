<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- 1. New enquiry on the Travel Desk -> send acknowledgement email -->
    <record id="automation_new_inquiry_ack" model="base.automation">
        <field name="name">Travel: Acknowledge New Enquiry</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain" eval="[('team_id', '=', ref('crm_team_travel_desk')), ('email_from', '!=', False)]"/>
    </record>
    <record id="action_new_inquiry_ack" model="ir.actions.server">
        <field name="name">Send acknowledgement email</field>
        <field name="base_automation_id" ref="automation_new_inquiry_ack"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">mail_post</field>
        <field name="template_id" ref="mail_template_inquiry_ack"/>
    </record>

    <!-- 2. Stage -> Itinerary Shared: schedule a follow-up call in 2 days -->
    <record id="automation_itinerary_followup" model="base.automation">
        <field name="name">Travel: Follow Up After Itinerary Shared</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_pre_domain" eval="[('stage_id', '!=', ref('stage_travel_itinerary_shared'))]"/>
        <field name="filter_domain" eval="[('stage_id', '=', ref('stage_travel_itinerary_shared'))]"/>
    </record>
    <record id="action_itinerary_followup" model="ir.actions.server">
        <field name="name">Schedule follow-up call</field>
        <field name="base_automation_id" ref="automation_itinerary_followup"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_call"/>
        <field name="activity_summary">Follow up on shared itinerary</field>
        <field name="activity_date_deadline_range">2</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>

    <!-- 3. Stage -> Booking Confirmed: send confirmation email + KYC reminder -->
    <record id="automation_booking_confirmed" model="base.automation">
        <field name="name">Travel: Booking Confirmed Follow-through</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_pre_domain" eval="[('stage_id', '!=', ref('stage_travel_booking_confirmed'))]"/>
        <field name="filter_domain" eval="[('stage_id', '=', ref('stage_travel_booking_confirmed'))]"/>
    </record>
    <record id="action_booking_confirmed_email" model="ir.actions.server">
        <field name="name">Send booking confirmation email</field>
        <field name="base_automation_id" ref="automation_booking_confirmed"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">mail_post</field>
        <field name="template_id" ref="mail_template_booking_confirmed"/>
    </record>
    <record id="action_booking_confirmed_kyc_activity" model="ir.actions.server">
        <field name="name">Schedule KYC document collection</field>
        <field name="base_automation_id" ref="automation_booking_confirmed"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="activity_summary">Collect KYC / travel documents</field>
        <field name="activity_date_deadline_range">1</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>

    <!-- 4. Call disposition -> Call Back Later: schedule reminder call tomorrow -->
    <record id="automation_call_back_later" model="base.automation">
        <field name="name">Travel: Call Back Later Reminder</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_pre_domain">[('x_call_disposition', '!=', 'call_back')]</field>
        <field name="filter_domain">[('x_call_disposition', '=', 'call_back')]</field>
    </record>
    <record id="action_call_back_later" model="ir.actions.server">
        <field name="name">Schedule call-back reminder</field>
        <field name="base_automation_id" ref="automation_call_back_later"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_call"/>
        <field name="activity_summary">Call back as requested</field>
        <field name="activity_date_deadline_range">1</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>

</odoo>
